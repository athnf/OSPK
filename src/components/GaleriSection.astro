---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import ldksImg from '../assets/kegiatan/ldks.jpg';
import mplsImg from '../assets/kegiatan/mpls.jpg';
import amansiveImg from '../assets/kegiatan/amansive.jpg';
import classmeetImg from '../assets/kegiatan/classmeet.jpg';
---

<section id="galeri" class="py-20 px-4 sm:px-6 lg:px-8 bg-white border-b border-slate-200">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-700 block mb-2">
        Dokumentasi Foto
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Galeri Kegiatan Sekolah
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        Dokumentasi visual rangkaian kegiatan yang telah berlangsung di SMK Negeri 65 Jakarta.
      </p>
    </div>

    <!-- 4-Grid Clean Image Showcase -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      <div class="aspect-4/3 rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
        <Image 
          src={ldksImg} 
          alt="LDKS SMKN 65" 
          width={400} 
          height={300} 
          format="webp" 
          loading="lazy" 
          class="w-full h-full object-cover" 
        />
      </div>

      <div class="aspect-4/3 rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
        <Image 
          src={mplsImg} 
          alt="MPLS SMKN 65" 
          width={400} 
          height={300} 
          format="webp" 
          loading="lazy" 
          class="w-full h-full object-cover" 
        />
      </div>

      <div class="aspect-4/3 rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
        <Image 
          src={amansiveImg} 
          alt="HUT SMKN 65" 
          width={400} 
          height={300} 
          format="webp" 
          loading="lazy" 
          class="w-full h-full object-cover" 
        />
      </div>

      <div class="aspect-4/3 rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
        <Image 
          src={classmeetImg} 
          alt="Class Meeting SMKN 65" 
          width={400} 
          height={300} 
          format="webp" 
          loading="lazy" 
          class="w-full h-full object-cover" 
        />
      </div>
    </div>

    <!-- Clean Google Drive Card -->
    <div class="p-8 sm:p-10 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-xl text-center md:text-left">
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2">
          Arsip Foto Resolusi Penuh di Google Drive
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Seluruh dokumentasi lengkap acara kesiswaan tersimpan di Google Drive resmi OSIS MPK SMKN 65 Jakarta untuk keperluan arsip kelas dan siswa.
        </p>
      </div>

      <a 
        href={siteConfig.socials.driveGallery} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-xs sm:text-sm font-semibold text-white bg-blue-700 hover:bg-blue-800 transition-colors shadow-sm flex-shrink-0"
      >
        <span>Buka Folder Google Drive</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

  </div>
</section>
