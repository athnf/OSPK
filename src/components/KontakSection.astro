---
import { siteConfig } from '../data/site';
---

<section id="kontak" class="py-20 px-4 sm:px-6 lg:px-8 bg-slate-50 border-b border-slate-200">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-700 block mb-2">
        Hubungi Kami
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Sekretariat & Alamat Resmi
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        Lokasi kampus sekolah dan saluran komunikasi resmi OSIS & MPK SMK Negeri 65 Jakarta.
      </p>
    </div>

    <!-- Grid Maps & Info -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
      
      <!-- Maps Embed (7 cols) -->
      <div class="lg:col-span-7 rounded-2xl overflow-hidden border border-slate-200 h-[380px] sm:h-[440px] bg-slate-200 shadow-xs relative">
        <iframe
          src={siteConfig.school.gmapsEmbed}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
          title="Lokasi Peta SMK Negeri 65 Jakarta"
        ></iframe>
      </div>

      <!-- Info Cards (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- School Identity Card with MapPin Icon -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
          <div class="flex items-center gap-2.5 text-blue-700 mb-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">
              Alamat Resmi Kemendikbud
            </span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">
            {siteConfig.school.name}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            {siteConfig.school.address}
          </p>
        </div>

        <!-- Contact Channels with Real Lucide SVG Icons -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4">
          
          <!-- Email Channel -->
          <div class="flex items-start gap-3.5">
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center flex-shrink-0 border border-blue-100">
              <!-- Mail SVG Icon -->
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="overflow-hidden">
              <span class="block text-[11px] font-semibold text-slate-400">Email Resmi Sekolah</span>
              <a href={`mailto:${siteConfig.school.email}`} class="text-xs sm:text-sm font-bold text-slate-800 hover:text-blue-700 transition-colors block">
                {siteConfig.school.email}
              </a>
              <a href={`mailto:${siteConfig.school.altEmail}`} class="text-[11px] text-slate-500 hover:text-blue-700 transition-colors block mt-0.5">
                {siteConfig.school.altEmail}
              </a>
            </div>
          </div>

          <!-- Phone Channel -->
          <div class="flex items-start gap-3.5 pt-4 border-t border-slate-100">
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center flex-shrink-0 border border-blue-100">
              <!-- Phone SVG Icon -->
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <span class="block text-[11px] font-semibold text-slate-400">Telepon Sekolah (Hunting)</span>
              <a href="tel:02121017367" class="text-xs sm:text-sm font-bold text-slate-800 hover:text-blue-700 transition-colors block">
                {siteConfig.school.phone}
              </a>
              <span class="text-[11px] text-slate-500 block mt-0.5">
                WhatsApp Kesiswaan: {siteConfig.school.whatsapp}
              </span>
            </div>
          </div>

        </div>

        <!-- Social Media Cards with Brand Logos -->
        <div class="grid grid-cols-2 gap-3">
          <!-- Instagram Card -->
          <a 
            href={siteConfig.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white p-4 rounded-xl border border-slate-200 hover:border-pink-300 hover:bg-pink-50/30 transition-all flex items-center gap-3 group shadow-2xs"
          >
            <div class="w-9 h-9 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center flex-shrink-0 group-hover:bg-pink-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs font-bold text-slate-900 group-hover:text-pink-600 transition-colors">Instagram</span>
              <span class="block text-[11px] text-slate-500">@osismpk65jkt</span>
            </div>
          </a>

          <!-- YouTube Card -->
          <a 
            href={siteConfig.socials.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white p-4 rounded-xl border border-slate-200 hover:border-red-300 hover:bg-red-50/30 transition-all flex items-center gap-3 group shadow-2xs"
          >
            <div class="w-9 h-9 rounded-xl bg-red-50 text-red-600 flex items-center justify-center flex-shrink-0 group-hover:bg-red-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </div>
            <div>
              <span class="block text-xs font-bold text-slate-900 group-hover:text-red-600 transition-colors">YouTube</span>
              <span class="block text-[11px] text-slate-500">osismpk65jkt</span>
            </div>
          </a>
        </div>

      </div>

    </div>

    <!-- Notice Box -->
    <div class="p-6 bg-white rounded-2xl border border-slate-200 text-slate-700 text-xs sm:text-sm leading-relaxed flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
      <div>
        <span class="font-bold text-slate-900 block mb-0.5">Informasi Seleksi Calon Pengurus Baru</span>
        <span class="text-slate-500">Jadwal seleksi pengurus OSIS & MPK SMKN 65 Jakarta diumumkan melalui koordinasi kesiswaan sekolah dan akun media sosial resmi.</span>
      </div>
      <a 
        href={siteConfig.socials.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-800 bg-slate-100 hover:bg-slate-200 transition-colors flex-shrink-0"
      >
        Lihat Pengumuman di Instagram
      </a>
    </div>

  </div>
</section>
