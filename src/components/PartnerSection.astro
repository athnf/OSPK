---
interface PartnerItem {
  name: string;
  category: string;
  type: 'telco' | 'beauty' | 'grooming' | 'publishing' | 'vendor';
  brandColor: string;
  description: string;
}

const partners: PartnerItem[] = [
  {
    name: "by.U",
    category: "Provider Digital Telkomsel",
    type: "telco",
    brandColor: "text-emerald-600 bg-emerald-50 border-emerald-200",
    description: "Sponsor telekomunikasi & connectivity acara sekolah",
  },
  {
    name: "Penerbit Erlangga",
    category: "Penerbit Pendidikan",
    type: "publishing",
    brandColor: "text-blue-700 bg-blue-50 border-blue-200",
    description: "Dukungan literasi, seminar, dan buku edukasi",
  },
  {
    name: "Gatsby",
    category: "Men's Grooming",
    type: "grooming",
    brandColor: "text-slate-900 bg-slate-100 border-slate-300",
    description: "Sponsor grooming & merchandise kegiatan siswa",
  },
  {
    name: "PIXY",
    category: "Beauty & Cosmetics",
    type: "beauty",
    brandColor: "text-pink-700 bg-pink-50 border-pink-200",
    description: "Sponsor beauty class & kegiatan pentas seni",
  },
  {
    name: "Klinsen",
    category: "Personal Care",
    type: "grooming",
    brandColor: "text-cyan-700 bg-cyan-50 border-cyan-200",
    description: "Dukungan produk kebersihan & kesehatan siswa",
  },
  {
    name: "DayMan",
    category: "Fragrance & Grooming",
    type: "grooming",
    brandColor: "text-indigo-700 bg-indigo-50 border-indigo-200",
    description: "Sponsor wewangian & booth interaktif agenda OSIS",
  },
  {
    name: "Teens",
    category: "Youth Media & Brand",
    type: "beauty",
    brandColor: "text-amber-700 bg-amber-50 border-amber-200",
    description: "Media partner publikasi dan aktivasi remaja",
  },
  {
    name: "Mega Putra",
    category: "Mitra Produksi & Percetakan",
    type: "vendor",
    brandColor: "text-slate-800 bg-slate-50 border-slate-200",
    description: "Penyedia perlengkapan dan logistik acara kesiswaan",
  },
];
---

<section id="mitra" class="py-20 px-4 sm:px-6 lg:px-8 bg-slate-50/70 border-b border-slate-200 relative overflow-hidden">
  
  <div class="max-w-6xl mx-auto relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-700 block mb-2">
          Kolaborasi & Kemitraan Acara
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Sponsor & Mitra Penyelenggaraan
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2 font-normal">
          Deretan brand nasional dan instansi yang pernah berkolaborasi mendukung suksesnya berbagai agenda besar kesiswaan SMKN 65 Jakarta (AMANSIVE, Pentas Seni, dan Kompetisi Siswa).
        </p>
      </div>

      <!-- Trust Badge -->
      <div class="flex-shrink-0">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 shadow-2xs text-xs font-semibold text-slate-700">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Kolaborasi Resmi Acara Sekolah</span>
        </div>
      </div>
    </div>

    <!-- Sponsor Grid Cards with Clean Authentic Typography Logos -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {partners.map((partner) => (
        <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-2xs hover:border-slate-300 hover:shadow-md transition-all flex flex-col justify-between group">
          
          <!-- Logo & Brand Header -->
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class={`px-2.5 py-1 rounded-md text-[10px] font-bold border ${partner.brandColor}`}>
                {partner.category}
              </span>
            </div>

            <!-- Stylized Brand Insignia Typography -->
            <div class="py-3">
              {partner.name === "by.U" && (
                <div class="flex items-center gap-1 font-black text-2xl tracking-tighter text-slate-900 group-hover:text-emerald-600 transition-colors">
                  <span>by</span>
                  <span class="text-emerald-500">.</span>
                  <span>U</span>
                </div>
              )}

              {partner.name === "Penerbit Erlangga" && (
                <div class="font-extrabold text-lg text-blue-900 tracking-tight group-hover:text-blue-700 transition-colors">
                  <span class="block text-[10px] uppercase font-bold text-slate-400 tracking-wider">PENERBIT</span>
                  <span>ERLANGGA</span>
                </div>
              )}

              {partner.name === "Gatsby" && (
                <div class="font-black text-2xl tracking-wider text-slate-900 uppercase font-sans group-hover:text-slate-700 transition-colors">
                  GATSBY
                </div>
              )}

              {partner.name === "PIXY" && (
                <div class="font-extrabold text-2xl tracking-widest text-slate-900 uppercase font-sans group-hover:text-pink-600 transition-colors">
                  PIXY
                </div>
              )}

              {partner.name === "Klinsen" && (
                <div class="font-extrabold text-xl tracking-wide text-slate-900 group-hover:text-cyan-700 transition-colors">
                  <span class="tracking-normal">KLINSEN</span>
                </div>
              )}

              {partner.name === "DayMan" && (
                <div class="font-black text-xl tracking-tight text-slate-900 uppercase group-hover:text-indigo-700 transition-colors">
                  DayMan
                </div>
              )}

              {partner.name === "Teens" && (
                <div class="font-black text-2xl tracking-tight text-slate-900 group-hover:text-amber-600 transition-colors">
                  <span class="italic">Teens</span>
                </div>
              )}

              {partner.name === "Mega Putra" && (
                <div class="font-extrabold text-lg tracking-tight text-slate-900 uppercase group-hover:text-slate-700 transition-colors">
                  MEGA PUTRA
                </div>
              )}
            </div>
          </div>

          <!-- Description Footer -->
          <div class="pt-3 border-t border-slate-100 text-[11px] text-slate-500 leading-normal">
            {partner.description}
          </div>

        </div>
      ))}
    </div>

    <!-- Partnership Callout -->
    <div class="mt-8 p-6 bg-white rounded-2xl border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
      <div>
        <span class="text-xs font-bold text-slate-900 block mb-0.5">Tertarik Menjadi Sponsor / Mitra Kegiatan Mendatang?</span>
        <span class="text-xs text-slate-500">Proposal kegiatan dan penawaran kemitraan dapat diajukan melalui bagian kesiswaan atau email resmi.</span>
      </div>
      <a 
        href="mailto:smkn65jkt@gmail.com?subject=Penawaran%20Kerjasama%20Sponsorship%20OSIS%20MPK%20SMKN%2065" 
        class="px-4 py-2 rounded-lg text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition-colors flex-shrink-0"
      >
        Ajukan Kerjasama Sponsorship
      </a>
    </div>

  </div>
</section>
