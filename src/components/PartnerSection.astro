---
// Daftar Brand & Sponsor Resmi yang Pernah Berkolaborasi dengan SMKN 65 Jakarta
interface PartnerItem {
  id: string;
  name: string;
  logo: string;
  category: string;
  type: 'telco' | 'publishing' | 'grooming' | 'beauty' | 'care' | 'media' | 'vendor';
  badge: string;
  description: string;
}

const partners: PartnerItem[] = [
  {
    id: "byu",
    name: "by.U",
    logo: "/images/partners/byu.png",
    category: "Provider Digital Telkomsel",
    type: "telco",
    badge: "Sponsor Resmi SMKN 65",
    description: "Konektivitas internet, kuota digital, dan booth aktivasi kegiatan siswa.",
  },
  {
    id: "erlangga",
    name: "Penerbit Erlangga",
    logo: "/images/partners/erlangga.svg",
    category: "Penerbit & Edukasi",
    type: "publishing",
    badge: "Mitra Kolaborasi",
    description: "Dukungan literasi sekolah, materi edukatif, dan apresiasi prestasi siswa.",
  },
  {
    id: "gatsby",
    name: "GATSBY",
    logo: "/images/partners/gatsby.svg",
    category: "Men's Grooming (Mandom)",
    type: "grooming",
    badge: "Sponsor Resmi SMKN 65",
    description: "Produk penata rambut, merchandise, dan refreshment penampilan siswa.",
  },
  {
    id: "pixy",
    name: "PIXY",
    logo: "/images/partners/pixy.png",
    category: "Beauty & Cosmetics",
    type: "beauty",
    badge: "Mitra Kolaborasi",
    description: "Goodie bag kecantikan, tata rias, dan aktivasi perawatan diri siswi.",
  },
  {
    id: "klinsen",
    name: "KLINSEN",
    logo: "/images/partners/klinsen.svg",
    category: "Personal & Body Care",
    type: "care",
    badge: "Sponsor Resmi SMKN 65",
    description: "Penyediaan produk kebersihan diri, sabun mandi, dan higienitas siswa.",
  },
  {
    id: "dayman",
    name: "DAYMAN",
    logo: "/images/partners/dayman.svg",
    category: "Men's Fragrance & Cologne",
    type: "grooming",
    badge: "Mitra Kolaborasi",
    description: "Wewangian pria aktif dan paket produk giveaway kegiatan kesiswaan.",
  },
  {
    id: "teens",
    name: "Teens",
    logo: "/images/partners/teens.svg",
    category: "Youth & Lifestyle Brand",
    type: "media",
    badge: "Sponsor Resmi SMKN 65",
    description: "Media publikasi, liputan kesiswaan, dan aktivasi gaya hidup remaja.",
  },
  {
    id: "megaputra",
    name: "MEGA PUTRA",
    logo: "/images/partners/megaputra.svg",
    category: "Produksi & Percetakan",
    type: "vendor",
    badge: "Mitra Resmi Sekolah",
    description: "Pengadaan seragam panitia, spanduk, perlengkapan, dan atribut acara.",
  },
];
---

<section id="mitra" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-slate-50/70 border-b border-slate-200 relative overflow-hidden">
  
  <!-- Subtle Architectural Texture -->
  <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:24px_24px] opacity-30 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    
    <!-- Section Header (Clean, Institutional, Factual) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 sm:mb-14">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold tracking-wide uppercase mb-3">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          Kolaborasi & Kemitraan
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Sponsor & Rekan Brand
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2 font-normal leading-relaxed">
          Brand nasional dan mitra industri yang pernah berkolaborasi serta mensponsori kegiatan siswa dan agenda resmi di SMKN 65 Jakarta.
        </p>
      </div>

      <!-- Trust Badge -->
      <div class="flex-shrink-0">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-xl bg-white border border-slate-200 shadow-2xs text-xs font-semibold text-slate-700">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Pernah Bekerja Sama dengan SMKN 65</span>
        </div>
      </div>
    </div>

    <!-- Responsive Dewa Grid: 2 kolom di HP, 4 kolom di Laptop/Desktop -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-5">
      {partners.map((partner) => (
        <div class="bg-white rounded-2xl border border-slate-200/90 hover:border-slate-300 p-4 sm:p-6 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group">
          
          <div>
            <!-- Top Status Badge -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-[10px] sm:text-[11px] font-bold text-slate-600 bg-slate-100/90 px-2 sm:px-2.5 py-0.5 rounded-md">
                {partner.badge}
              </span>
              <span class="text-[10px] text-emerald-600 font-semibold hidden sm:inline-block">
                ✓ Mitra 65
              </span>
            </div>

            <!-- Authentic Official Brand Logo Display -->
            <div class="h-16 sm:h-20 flex items-center justify-center p-2 rounded-xl bg-slate-50/50 group-hover:bg-slate-50 transition-colors mb-4">
              {partner.id === "erlangga" ? (
                <div class="flex items-center justify-center gap-2 w-full h-full">
                  <img 
                    src={partner.logo} 
                    alt={partner.name}
                    class="h-10 sm:h-12 w-auto object-contain flex-shrink-0"
                    loading="lazy"
                  />
                  <div class="text-left">
                    <span class="block text-[8px] sm:text-[9px] font-extrabold uppercase text-slate-400 tracking-wider">PENERBIT</span>
                    <span class="block text-xs sm:text-sm font-black text-blue-900 tracking-tight font-serif leading-none">ERLANGGA</span>
                  </div>
                </div>
              ) : (
                <img 
                  src={partner.logo} 
                  alt={partner.name}
                  class={`w-auto object-contain transition-transform group-hover:scale-105 ${
                    partner.id === 'byu' ? 'h-9 sm:h-11' :
                    partner.id === 'gatsby' ? 'h-7 sm:h-8' :
                    partner.id === 'pixy' ? 'h-7 sm:h-9' :
                    'h-8 sm:h-10 max-w-full'
                  }`}
                  loading="lazy"
                />
              )}
            </div>

            <!-- Brand Name & Category -->
            <div class="mb-2">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-blue-700 transition-colors">
                {partner.name}
              </h3>
              <p class="text-[11px] sm:text-xs font-medium text-slate-500">
                {partner.category}
              </p>
            </div>

            <!-- Description (Peran Kolaborasi) -->
            <p class="text-[10px] sm:text-[11px] text-slate-600 leading-relaxed font-normal">
              {partner.description}
            </p>
          </div>

          <!-- Bottom Footer Card -->
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-500">
            <span>Kolaborasi Siswa</span>
            <span class="font-semibold text-slate-700">SMKN 65</span>
          </div>

        </div>
      ))}
    </div>

    <!-- Official Partnership Callout (Clean & Institutional) -->
    <div class="mt-10 sm:mt-12 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-2xs">
      <div class="max-w-xl">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          <span class="text-xs font-bold text-slate-900 uppercase tracking-wide">Peluang Kolaborasi & Sponsorship</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          Pengurus OSIS & MPK SMKN 65 Jakarta senantiasa terbuka untuk menjalin kemitraan, sponsorship, serta kolaborasi program kesiswaan bersama brand dan instansi.
        </p>
      </div>
      
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto flex-shrink-0">
        <a 
          href="mailto:smkn65jkt@gmail.com?subject=Proposal%20Sponsorship%20Kemitraan%20SMKN%2065%20Jakarta" 
          class="px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-blue-700 hover:bg-blue-800 shadow-2xs transition-colors text-center"
        >
          Kirim Proposal Sponsor
        </a>
        <a 
          href="https://wa.me/6281511927805?text=Halo%20Pengurus%20OSIS%20MPK%20SMKN%2065%20Jakarta,%20kami%20tertarik%20menjalin%20kerjasama%20sponsorship." 
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-colors text-center"
        >
          Hubungi via WhatsApp
        </a>
      </div>
    </div>

  </div>
</section>
