---
import { Image } from 'astro:assets';
import { silsilahAngkatan } from '../data/sejarah';
---

<section id="sejarah" class="py-24 px-4 sm:px-6 lg:px-8 bg-slate-50/60 border-b border-slate-200 relative overflow-hidden">
  
  <!-- Subtle background grid -->
  <div class="absolute inset-0 grid-pattern opacity-40 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-semibold text-blue-700 shadow-2xs mb-3">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span>Silsilah & Rekam Jejak Angkatan</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Pohon Estafet Kepemimpinan
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-3 font-normal">
        Rangkaian estafet kepengurusan OSIS & MPK SMKN 65 Jakarta dari periode 2020/2021 hingga rencana regenerasi 2026/2027.
      </p>
    </div>

    <!-- Tree Graph Interactive Branching Timeline -->
    <div class="relative">
      
      <!-- Central Tree Trunk Line (Batang Utama Pohon) -->
      <div class="hidden md:block absolute left-1/2 top-4 bottom-8 -translate-x-1/2 w-1 bg-gradient-to-b from-blue-600 via-slate-300 to-slate-200 rounded-full z-0"></div>

      <!-- Mobile Left Trunk Line -->
      <div class="md:hidden absolute left-5 top-4 bottom-8 w-1 bg-gradient-to-b from-blue-600 to-slate-200 rounded-full z-0"></div>

      <div class="space-y-12 sm:space-y-16">
        {silsilahAngkatan.map((item, index) => {
          const isLeft = index % 2 === 0;
          const hasImage = !!item.image;
          const isCurrent = item.status === 'Masa Bakti Berjalan';
          const isFuture = item.status === 'Periode Mendatang';

          return (
            <div class="relative flex flex-col md:flex-row items-center group">
              
              <!-- Center Branch Node (Titik Simpul Batang Pohon) -->
              <div class="absolute left-5 md:left-1/2 -translate-x-1/2 w-11 h-11 rounded-full bg-white border-4 border-blue-600 shadow-md flex items-center justify-center z-20 group-hover:scale-110 transition-transform">
                <span class="text-[11px] font-black text-slate-900">
                  {item.period.slice(2, 4)}
                </span>
              </div>

              <!-- Left Branch Content -->
              <div class={`w-full md:w-1/2 pl-14 md:pl-0 ${isLeft ? 'md:pr-14 md:text-right' : 'md:order-2 md:pl-14 md:text-left'}`}>
                <div class={`bg-white rounded-2xl border p-6 sm:p-7 shadow-xs hover:shadow-md transition-all ${
                  isCurrent 
                    ? 'border-blue-400 ring-2 ring-blue-500/10' 
                    : isFuture 
                    ? 'border-dashed border-slate-300 bg-slate-50/80' 
                    : 'border-slate-200 hover:border-slate-300'
                }`}>
                  
                  <!-- Card Header Meta -->
                  <div class={`flex flex-wrap items-center gap-2 mb-3 ${isLeft ? 'md:justify-end' : 'md:justify-start'}`}>
                    <span class={`px-3 py-1 rounded-lg text-xs font-bold ${
                      isCurrent 
                        ? 'bg-blue-600 text-white' 
                        : isFuture
                        ? 'bg-slate-200 text-slate-700'
                        : 'bg-blue-50 text-blue-800 border border-blue-200/60'
                    }`}>
                      Periode {item.period}
                    </span>
                    <span class="text-xs font-semibold text-slate-500">
                      {item.generation}
                    </span>
                    {isCurrent && (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                        Aktif Berjalan
                      </span>
                    )}
                  </div>

                  <!-- Title & Theme -->
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 leading-snug">
                    {item.theme}
                  </h3>

                  <!-- Quote if present -->
                  {item.quote && (
                    <p class="text-xs sm:text-sm italic text-blue-700 font-medium mb-3">
                      "{item.quote}"
                    </p>
                  )}

                  <!-- Description -->
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal mb-4">
                    {item.description}
                  </p>

                  <!-- Status Note -->
                  <div class={`text-[11px] font-medium pt-3 border-t border-slate-100 flex items-center gap-1.5 ${
                    isLeft ? 'md:justify-end' : 'md:justify-start'
                  } ${isCurrent ? 'text-blue-700 font-bold' : 'text-slate-400'}`}>
                    <span>Status: {item.status}</span>
                  </div>

                </div>
              </div>

              <!-- Right Branch (Image or "Segera Diperbarui" Box) -->
              <div class={`w-full md:w-1/2 pl-14 md:pl-0 mt-4 md:mt-0 ${isLeft ? 'md:pl-14' : 'md:order-1 md:pr-14'}`}>
                {hasImage && item.image ? (
                  <div class="rounded-2xl overflow-hidden bg-white p-2 border border-slate-200 shadow-xs group-hover:border-slate-300 transition-all">
                    <div class="aspect-16/10 rounded-xl overflow-hidden bg-slate-100 relative">
                      <Image 
                        src={item.image} 
                        alt={`Dokumentasi kepengurusan periode ${item.period}`}
                        widths={[340, 560]}
                        format="webp"
                        quality={82}
                        loading="lazy"
                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                      <div class="absolute bottom-2 left-2 px-2.5 py-0.5 rounded-md bg-slate-900/80 backdrop-blur-xs text-white text-[10px] font-semibold">
                        Arsip {item.period}
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="aspect-16/10 rounded-2xl border-2 border-dashed border-slate-300 bg-white/70 p-6 flex flex-col items-center justify-center text-center shadow-2xs">
                    <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-2.5">
                      <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <span class="text-xs font-bold text-slate-700 block mb-1">
                      Dokumentasi Segera Diperbarui
                    </span>
                    <span class="text-[11px] text-slate-500 max-w-xs leading-normal">
                      {isCurrent 
                        ? 'Dokumentasi foto kegiatan periode 2024/2025 sedang dalam tahap kompilasi tim kesiswaan.' 
                        : `Arsip dokumentasi periode ${item.period} akan ditambahkan setelah masa jabatan dimulai.`
                      }
                    </span>
                  </div>
                )}
              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>
