---
import { Image } from 'astro:assets';
import { sejarahTimeline } from '../data/sejarah';
---

<section id="sejarah" class="py-20 px-4 sm:px-6 lg:px-8 bg-slate-50 border-b border-slate-200">
  <div class="max-w-5xl mx-auto">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-14 text-center sm:text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-700 block mb-2">
        Kilas Balik Kepengurusan
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Catatan Perjalanan 2020 – 2024
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        Arsip dokumentasi dan dinamika pelaksanaan kegiatan kesiswaan lintas generasi di SMKN 65 Jakarta.
      </p>
    </div>

    <!-- Timeline List -->
    <div class="space-y-8">
      {sejarahTimeline.map((item) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 flex flex-col md:flex-row items-center gap-6 shadow-xs hover:border-slate-300 transition-colors">
          
          <!-- Image Box (Fixed Aspect Ratio) -->
          <div class="w-full md:w-56 h-40 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-200/80">
            <Image 
              src={item.image} 
              alt={`Dokumentasi angkatan ${item.year}`}
              widths={[240, 480]}
              format="webp"
              quality={80}
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Content Body -->
          <div class="flex-1 text-left w-full">
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 rounded-md text-xs font-bold bg-blue-100 text-blue-800">
                {item.year}
              </span>
              <span class="text-xs font-semibold text-slate-400">
                &bull; Periode Kepengurusan
              </span>
            </div>
            
            <h3 class="text-lg font-bold text-slate-900 mb-1">
              {item.theme}
            </h3>

            <p class="text-xs sm:text-sm italic text-slate-500 mb-2">
              "{item.quote}"
            </p>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              {item.description}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
