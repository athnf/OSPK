---
import { siteConfig } from '../data/site';
---

<section id="home" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-slate-50 border-b border-slate-200">
  <div class="max-w-4xl mx-auto text-center">
    
    <!-- Verified Status Pill -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-blue-50 border border-blue-200 text-xs font-semibold text-blue-800 mb-6">
      <span class="w-2 h-2 rounded-full bg-blue-600"></span>
      <span>Unit Kesiswaan &bull; SMK Negeri 65 Jakarta</span>
    </div>

    <!-- Editorial Main Headline -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15] mb-6">
      Organisasi Siswa Intra Sekolah & Majelis Perwakilan Kelas
    </h1>

    <!-- Authentic Subtitle -->
    <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed mb-8 font-normal">
      Portal resmi dokumentasi program kerja, penyaluran aspirasi perwakilan kelas, dan arsip kegiatan kesiswaan SMK Negeri 65 Jakarta di Jatinegara.
    </p>

    <!-- Clean Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-12">
      <a 
        href="#kegiatan" 
        class="w-full sm:w-auto px-6 py-3 rounded-lg text-sm font-semibold text-white bg-blue-700 hover:bg-blue-800 transition-colors shadow-sm"
      >
        Lihat Program Kerja
      </a>
      <a 
        href="#kontak" 
        class="w-full sm:w-auto px-6 py-3 rounded-lg text-sm font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 transition-colors"
      >
        Lokasi & Kontak Sekolah
      </a>
    </div>

    <!-- Verified Institutional Facts Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-8 border-t border-slate-200 text-left">
      <div class="p-4 bg-white rounded-xl border border-slate-200">
        <span class="block text-xs font-medium text-slate-500">Struktur</span>
        <span class="block text-lg font-bold text-slate-900">10 Sekbid</span>
        <span class="block text-[11px] text-slate-400">Seksi bidang aktif</span>
      </div>
      <div class="p-4 bg-white rounded-xl border border-slate-200">
        <span class="block text-xs font-medium text-slate-500">Lembaga</span>
        <span class="block text-lg font-bold text-slate-900">OSIS & MPK</span>
        <span class="block text-[11px] text-slate-400">Mitra kesiswaan</span>
      </div>
      <div class="p-4 bg-white rounded-xl border border-slate-200">
        <span class="block text-xs font-medium text-slate-500">Arsip</span>
        <span class="block text-lg font-bold text-slate-900">2020 – 2024</span>
        <span class="block text-[11px] text-slate-400">Rekam jejak terdokumentasi</span>
      </div>
      <div class="p-4 bg-white rounded-xl border border-slate-200">
        <span class="block text-xs font-medium text-slate-500">Lokasi</span>
        <span class="block text-lg font-bold text-slate-900">Jatinegara</span>
        <span class="block text-[11px] text-slate-400">Jakarta Timur</span>
      </div>
    </div>

  </div>
</section>
