---
import { Image } from 'astro:assets';
import ldksImg from '../assets/kegiatan/ldks.jpg';
import mplsImg from '../assets/kegiatan/mpls.jpg';
import logoSmk from '../assets/brand/logo-smkn65.png';
import { siteConfig } from '../data/site';
---

<section id="home" class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 px-4 sm:px-6 lg:px-8 bg-slate-50 border-b border-slate-200 overflow-hidden">
  
  <!-- Subtle architectural grid texture in background -->
  <div class="absolute inset-0 grid-pattern opacity-60 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Editorial & Context -->
      <div class="lg:col-span-7 text-left">
        
        <!-- Institutional Badge with Logo -->
        <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-white border border-slate-200/90 shadow-2xs mb-6">
          <Image src={logoSmk} alt="Logo SMKN 65" width={20} height={20} class="w-5 h-5 object-contain" />
          <span class="text-xs font-semibold text-slate-700">Unit Kesiswaan SMKN 65 Jakarta</span>
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          <span class="text-[11px] font-medium text-slate-500">Jatinegara</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.12] mb-6">
          Penggerak Aspirasi, Tradisi, & Kreasi Siswa SMKN 65
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal mb-8 max-w-xl">
          Portal dokumentasi resmi program kerja, rekam jejak kepengurusan, dan sarana penyampaian aspirasi perwakilan kelas SMK Negeri 65 Jakarta.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-10">
          <a 
            href="#kegiatan" 
            class="px-6 py-3.5 rounded-xl text-sm font-semibold text-white bg-blue-700 hover:bg-blue-800 transition-colors shadow-sm flex items-center justify-center gap-2 group"
          >
            <span>Telusuri Program Kerja</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href="#sejarah" 
            class="px-6 py-3.5 rounded-xl text-sm font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-100 hover:text-slate-900 transition-colors flex items-center justify-center gap-2"
          >
            <span>Silsilah Angkatan 2020–2027</span>
          </a>
        </div>

        <!-- Institutional Fact Strip -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-slate-200">
          <div>
            <span class="block text-xl sm:text-2xl font-black text-slate-900">10 Sekbid</span>
            <span class="block text-xs text-slate-500 mt-0.5">Seksi bidang aktif</span>
          </div>
          <div>
            <span class="block text-xl sm:text-2xl font-black text-blue-700">7 Periode</span>
            <span class="block text-xs text-slate-500 mt-0.5">2020 s/d 2027</span>
          </div>
          <div>
            <span class="block text-xl sm:text-2xl font-black text-slate-900">Cipinang</span>
            <span class="block text-xs text-slate-500 mt-0.5">Jakarta Timur</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Showcase Mosaic -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Primary Framed Image -->
          <div class="rounded-2xl overflow-hidden bg-white p-2.5 border border-slate-200/90 shadow-xl">
            <div class="aspect-4/3 rounded-xl overflow-hidden bg-slate-100 relative">
              <Image 
                src={ldksImg} 
                alt="Dokumentasi LDKS Siswa SMKN 65" 
                widths={[420, 600]}
                format="webp"
                quality={85}
                class="w-full h-full object-cover"
              />
              <div class="absolute bottom-3 left-3 px-3 py-1 rounded-md bg-slate-900/80 backdrop-blur-sm text-white text-xs font-semibold flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>LDKS &bull; Kaderisasi Kepemimpinan</span>
              </div>
            </div>
          </div>

          <!-- Secondary Overlapping Card -->
          <div class="hidden sm:block absolute -bottom-8 -left-8 w-56 rounded-2xl bg-white p-2 border border-slate-200/90 shadow-2xl">
            <div class="aspect-video rounded-xl overflow-hidden bg-slate-100 relative">
              <Image 
                src={mplsImg} 
                alt="Dokumentasi MPLS Siswa Baru" 
                widths={[240, 320]}
                format="webp"
                quality={80}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-2">
              <span class="text-[11px] font-bold text-slate-900 block">Penyambutan MPLS</span>
              <span class="text-[10px] text-slate-500 block">Siswa Baru Kelas X</span>
            </div>
          </div>

          <!-- Floating Status Chip -->
          <div class="absolute -top-4 -right-4 bg-white border border-slate-200/90 rounded-xl px-4 py-2.5 shadow-lg flex items-center gap-2.5">
            <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></div>
            <div>
              <span class="block text-xs font-bold text-slate-900 leading-none">Masa Bakti Aktif</span>
              <span class="block text-[10px] text-slate-500 mt-0.5">SMKN 65 Jakarta</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
