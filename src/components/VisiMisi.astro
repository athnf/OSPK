---
import { visiMisiData } from '../data/visimisi';
---

<section id="visimisi" class="py-20 px-4 sm:px-6 lg:px-8 bg-white border-b border-slate-200">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-700 block mb-2">
        Pedoman Organisasi
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Visi & Misi Kesiswaan
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        Arah kebijakan dan prinsip dasar pelaksanaan program kerja OSIS dan MPK SMKN 65 Jakarta.
      </p>
    </div>

    <!-- Grid Visi & Misi Clean Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
      
      <!-- Visi Card (5 cols) -->
      <div class="lg:col-span-5 p-8 bg-slate-50 rounded-2xl border border-slate-200">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-3">Visi</span>
        <blockquote class="text-lg sm:text-xl font-semibold text-slate-900 leading-snug mb-6">
          "{visiMisiData.visi}"
        </blockquote>
        <div class="text-xs text-slate-500 pt-4 border-t border-slate-200">
          Landasan kerja kepengurusan OSIS & MPK SMKN 65 Jakarta
        </div>
      </div>

      <!-- Misi Cards (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        {visiMisiData.misi.map((item, index) => (
          <div class="p-6 bg-white rounded-xl border border-slate-200 shadow-xs flex items-start gap-4">
            <span class="w-7 h-7 rounded-md bg-blue-100 text-blue-800 flex items-center justify-center font-bold text-xs flex-shrink-0">
              {index + 1}
            </span>
            <div>
              <h3 class="text-base font-bold text-slate-900 mb-1">{item.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- Core Values Bar -->
    <div class="p-6 sm:p-8 bg-slate-50 rounded-2xl border border-slate-200">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-600 mb-4">
        Prinsip Kerja Pengurus
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {visiMisiData.coreValues.map((v) => (
          <div class="bg-white p-4 rounded-xl border border-slate-200">
            <span class="block text-sm font-bold text-slate-900 mb-1">{v.name}</span>
            <span class="block text-xs text-slate-500 leading-normal">{v.desc}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
