---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import VisiMisi from '../components/VisiMisi.astro';
import BentoKegiatan from '../components/BentoKegiatan.astro';
import PartnerSection from '../components/PartnerSection.astro';
import SejarahTimeline from '../components/SejarahTimeline.astro';
import GaleriSection from '../components/GaleriSection.astro';
import KontakSection from '../components/KontakSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main class="flex-1">
    <Hero />
    <VisiMisi />
    <BentoKegiatan />
    <PartnerSection />
    <SejarahTimeline />
    <GaleriSection />
    <KontakSection />
  </main>
  <Footer />
</Layout>
